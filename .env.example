# Copy this file to .env (which is gitignored: never commit real secrets) and fill in the values.
# docker-compose.yml reads the infrastructure settings; src/ekyc reads the rest (python-dotenv).

# --- infrastructure (docker-compose.yml) ---
# KRaft cluster id: 22 characters, e.g. from: python -c "import base64,uuid;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
KAFKA_CLUSTER_ID=
KAFKA_HEAP=512m
# Kafka as seen from the host (the workers): the EXTERNAL listener
KAFKA_BOOTSTRAP=localhost:9094
MONGO_ROOT_USER=ekyc
MONGO_ROOT_PASSWORD=
MONGO_HOST=localhost:27017
MONGO_DB=ekyc
S3_ENDPOINT=http://localhost:9000
# RustFS credentials: choose your own (never the well-known default "rustfsadmin")
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kyc-uploads
S3_REGION=us-east-1

# --- local vision LLM (Ollama runs on the host; containers would use http://host.docker.internal:11434) ---
OLLAMA_HOST=http://localhost:11434

# --- optional cloud LLM for field extraction (ekyc.extraction.CloudExtractor) ---
# With LLM_API_KEY empty, the cloud path is skipped and only the local Ollama model is used.
# anthropic | openai
LLM_PROVIDER=anthropic
# a vision-capable model of that provider, e.g. claude-sonnet-5-5 (anthropic)
LLM_MODEL=
LLM_API_KEY=
