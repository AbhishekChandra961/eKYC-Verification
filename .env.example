# Copy this file to .env (which is gitignored: never commit a real key) and fill in the values.
# Read by ekyc.extraction.CloudExtractor.from_env(). With LLM_API_KEY empty, the cloud path is skipped
# and only the local Ollama model (qwen2.5vl:7b, "private mode") is used.

# anthropic | openai
LLM_PROVIDER=anthropic
# a vision-capable model of that provider, e.g. claude-sonnet-5-5 (anthropic)
LLM_MODEL=
LLM_API_KEY=
